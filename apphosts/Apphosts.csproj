<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
  	<OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>jobdeck-apphosts</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Blazor" Version="13.6.1-preview.1.26506.6" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Go" Version="13.6.1-preview.1.26506.6" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Yarp" Version="13.6.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
